# Order Desk backend - environment variables.
# Copy to .env (never commit .env!) and adjust. Every value below is optional:
# application.properties already contains the same local defaults.
#
# Spring Boot maps these names onto its properties automatically, e.g.
# SPRING_DATASOURCE_URL -> spring.datasource.url

# --- MariaDB ---
SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3306/orderdesk
SPRING_DATASOURCE_USERNAME=orderdesk
SPRING_DATASOURCE_PASSWORD=orderdesk

# --- Redis ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# --- RabbitMQ ---
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# --- CORS: browser origins allowed to call /api/** (comma-separated) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
